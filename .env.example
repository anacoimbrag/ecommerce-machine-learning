# Copie para .env e ajuste. .env é ignorado pelo git.

# Warehouse ClickHouse do agentic-cdp (../agentic-cdp) -- ecomm-ml só lê/escreve
# nele, não sobe ClickHouse próprio. Suba com (cd ../agentic-cdp && ./stack.sh up).
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=raw
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_local_dev

# Serving store do ml-api (lido só por api/db.py, gravado por
# export_to_serving_store.py) -- precisa ser absoluto porque os dois rodam
# com cwd diferente.
SERVING_STORE_PATH="/absolute/path/to/ecomm-ml/output/serving_store.sqlite"
