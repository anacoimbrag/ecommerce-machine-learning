# Copie para .env e ajuste. .env é ignorado pelo git.

# Warehouse ClickHouse do ecommerce-data-pipeline (../ecommerce-data-pipeline) -- ecommerce-machine-learning só lê/escreve
# nele, não sobe ClickHouse próprio. Suba com (cd ../ecommerce-data-pipeline && ./stack.sh up).
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=raw
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_local_dev

# Serving store do ml-api (lido só por api/db.py, gravado por
# export_to_serving_store.py) -- precisa ser absoluto porque os dois rodam
# com cwd diferente.
SERVING_STORE_PATH="/absolute/path/to/ecommerce-machine-learning/output/serving_store.sqlite"
